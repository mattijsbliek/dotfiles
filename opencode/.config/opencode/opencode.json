{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "model": "litellm/claude-sonnet-5",
  "permission": {
    "websearch": "allow"
  },
  "agent": {
    "explore": {
      "model": "litellm/claude-sonnet-5"
    },
    "plan": {
      "model": "litellm/claude-opus-4-8"
    }
  },
  "disabled_providers": [
    "opencode",
    "anthropic"
  ],
  "plugin": [
    "./plugin/sync-models.ts"
  ],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://localhost:1337/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "claude-sonnet-5": {
          "id": "claude-sonnet-5",
          "created_at": "2023-02-28T18:56:42Z",
          "name": "Claude Sonnet 5"
        },
        "claude-opus-4-8": {
          "id": "claude-opus-4-8",
          "created_at": "2023-02-28T18:56:42Z",
          "name": "Claude Opus 4.8"
        },
        "claude-opus-5": {
          "id": "claude-opus-5",
          "created_at": "2023-02-28T18:56:42Z",
          "name": "Claude Opus 5"
        },
        "gemini-2.5-pro": {
          "id": "gemini-2.5-pro",
          "created_at": "2023-02-28T18:56:42Z",
          "name": "Gemini 2.5 Pro"
        },
        "gemini-3.5-flash": {
          "id": "gemini-3.5-flash",
          "created_at": "2023-02-28T18:56:42Z",
          "name": "Gemini 3.5 Flash"
        }
      }
    }
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": false
    },
    "gitlab": {
      "type": "remote",
      "url": "https://gitlab.molops.io/api/v4/mcp",
      "enabled": false
    },
    "gke-mcp": {
      "type": "local",
      "command": [
        "gke-mcp"
      ],
      "env": {},
      "enabled": false
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.eu/api/unstable/mcp-server/mcp",
      "enabled": false
    },
    "slack": {
      "type": "remote",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "{env:SLACK_MCP_CLIENT_ID}",
        "redirectUri": "http://localhost:3118/callback"
      },
      "enabled": true
    }
  }
}

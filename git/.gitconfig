[core]
	filemode = false
	editor = nvim
	autocrlf = input
	excludesfile = ~/.gitignore_global
	pager = diff-so-fancy | less --tabs=4 -RFX
	fsmonitor = true
	untrackedCache = true
[user]
	name = Mattijs Bliek
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ6b6EVlKkmf6zBf6NkRc5pRr71YMFhc0a4qSUNiuLp0
	email = mattijs@mattijsbliek.com
[alias]
	co = checkout
	ci = commit
	st = status
	br = branch
	hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
	ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
	ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat
	type = cat-file -t
	dump = cat-file -p
	changelog = diff-tree --no-commit-id --name-only
	amend = commit --amend -C HEAD
[push]
	default = upstream
	autoSetupRemote = true
[merge]
	tool = vimdiff
	conflictStyle = zdiff3
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[rerere]
	enabled = true
[gpg]
	format = ssh
[include]
	path = ~/.gitconfig.local
[includeIf "gitdir:/Users/"]
	path = ~/.gitconfig.macos
[includeIf "gitdir:/home/"]
	path = ~/.gitconfig.linux
[branch]
	sort = committerdate
[checkout]
	workers = 0
[commit]
	verbose = true
[diff]
	algorithm = histogram
	colorMoved = plain
	renames = copies
[feature]
	manyFiles = false
[fetch]
	prune = true
	pruneTags = true
[help]
	autocorrect = prompt
[index]
	version = 4
[init]
	defaultBranch = main
[lfs]
	locksverify = false
	setlockablereadonly = false
[log]
	date = iso
[pack]
	useSparse = true
[pull]
	rebase = true
[rebase]
	autoStash = true
	updateRefs = true
[tag]
	sort = refname
[credential "https://gitlab.molops.io"]
	helper = 
	helper = !/usr/local/bin/mol gitlab git-credential-provider
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
